[0.3, "o", "\u001b[38;2;61;220;132m\u276f\u001b[0m "]
[0.9, "o", "brew tap semenov/hum"]
[1.5, "o", "\r\n"]
[1.9, "o", "==> Tapping semenov/hum\r\nTapped 1 formula (14 files, 9.7KB).\r\n"]
[2.2, "o", "\u001b[38;2;61;220;132m\u276f\u001b[0m "]
[2.7, "o", "brew trust semenov/hum"]
[3.1, "o", "\r\n"]
[3.4, "o", "Trusted tap: semenov/hum\r\n"]
[3.7, "o", "\u001b[38;2;61;220;132m\u276f\u001b[0m "]
[4.2, "o", "brew install --HEAD hum"]
[4.7, "o", "\r\n"]
[5.0, "o", "==> Installing hum from semenov/hum\r\n"]
[5.4, "o", "==> \u001b[2mpython3.12 -m venv .../libexec/venv\u001b[0m\r\n"]
[5.9, "o", "==> \u001b[2mpip install --quiet --require-hashes -r requirements.txt\u001b[0m\r\n"]
[6.6, "o", "==> \u001b[2mgo build -ldflags ...\u001b[0m\r\n"]
[7.2, "o", "\ud83c\udf7a  /opt/homebrew/Cellar/hum/HEAD: 431.8MB, built in 16 seconds\r\n"]
[7.7, "o", "\u001b[38;2;61;220;132m\u276f\u001b[0m "]
[8.3, "o", "hum start"]
[8.8, "o", "\r\n"]
[9.2, "o", "  \u001b[38;2;78;168;255m\u2839\u001b[0m Loading Qwen3.6 35B-A3B \u001b[2m2s\u001b[0m\r"]
[9.7, "o", "  \u001b[38;2;78;168;255m\u283c\u001b[0m Loading Qwen3.6 35B-A3B \u001b[2m5s\u001b[0m\r"]
[10.2, "o", "\u001b[2K\r\r\n  \u001b[38;2;61;220;132m\u25cf\u001b[0m \u001b[1mHum is ready.\u001b[0m\r\n\r\n    \u001b[2mThe server is listening on http://127.0.0.1:4242 and speaks the\u001b[0m\r\n    \u001b[2mOpenAI chat completions API. Point OpenCode, your editor, or any\u001b[0m\r\n    \u001b[2mOpenAI SDK at it \u2014 no API key is required.\u001b[0m\r\n\r\n    \u001b[2mModel\u001b[0m       \u001b[38;2;78;168;255mQwen3.6 35B-A3B\u001b[0m\r\n    \u001b[2mLogs\u001b[0m        \u001b[38;2;78;168;255m~/.hum/hum.log\u001b[0m\r\n\r\n    \u001b[2mStop it again with\u001b[0m \u001b[38;2;78;168;255mhum stop\u001b[0m\r\n\r\n"]
[10.6, "o", "\u001b[38;2;61;220;132m\u276f\u001b[0m "]
[11.3, "o", "hum ask 'name three roman emperors, one line each'"]
[11.9, "o", "\r\n"]
[12.6, "o", "Augustus\r\n"]
[12.9, "o", "Trajan\r\n"]
[13.2, "o", "Marcus Aurelius\r\n"]
[13.6, "o", "\u001b[38;2;61;220;132m\u276f\u001b[0m "]
