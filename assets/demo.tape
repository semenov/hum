# Regenerate with:  HOMEBREW_NO_AUTO_UPDATE=1 vhs assets/demo.tape
# The model must already be downloaded, or the recording waits for 20 GB.
Output assets/demo.gif

Set Shell zsh
Set FontSize 16
Set Width 1160
Set Height 660
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms

Sleep 800ms
Type "brew install --HEAD semenov/hum/hum" Sleep 500ms Enter
Sleep 24s

Type "clear" Enter
Sleep 400ms

Type "hum start" Sleep 400ms Enter
Sleep 13s

Type "hum ask 'name three roman emperors, one line each'" Sleep 500ms Enter
Sleep 13s

Sleep 2s
